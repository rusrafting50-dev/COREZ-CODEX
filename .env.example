# Секретный ключ Flask (сессии, flash-сообщения)
SECRET_KEY=change-me-to-a-random-secret

# Пароль для входа в раздел «Настройки» (списки субъектов ЦФО и
# муниципальных образований для фильтров на главной, импорт из Excel).
SETTINGS_PASSWORD=change-me-to-a-strong-password

# Адрес сайта RAFTING_CFO и API-ключ синхронизации соревнований.
# API-ключ должен СОВПАДАТЬ со значением API_KEY в .env самого сайта
# RAFTING_CFO (см. его .env.example, заголовок X-API-Key).
RAFTING_CFO_URL=http://127.0.0.1:5003
RAFTING_CFO_API_KEY=change-me-to-a-random-api-key

# Ключ для входящих запросов (заголовок X-API-Key, см. routes/api.py) —
# один общий ключ на все источники:
#  - сайт RAFTING_CFO передаёт сюда заявки команд кнопкой «Отправить в
#    COREZ» (значение должно СОВПАДАТЬ со значением COREZ_API_KEY в .env
#    самого сайта RAFTING_CFO);
#  - SPORTS_REFEREE передаёт сюда судей в судейскую коллегию соревнования
#    и запрашивает список соревнований (значение должно СОВПАДАТЬ со
#    значением COREZ_API_KEY в .env SPORTS_REFEREE).
API_KEY=change-me-to-a-random-api-key

# Адрес SPORTS_REFEREE и API-ключ для поиска судей по его базе прямо с
# формы добавления судьи в судейскую коллегию (routes/судьи.py /поиск,
# sync_sports_referee.py). Значение должно СОВПАДАТЬ со значением API_KEY
# в .env самого SPORTS_REFEREE (см. его .env.example, заголовок X-API-Key).
SPORTS_REFEREE_URL=http://127.0.0.1:5002
SPORTS_REFEREE_API_KEY=change-me-to-a-random-api-key

# Адрес REGTEAM_RAFTING и API-ключ для поиска спортсменов по его базе
# прямо с формы предварительной заявки на соревнование (routes/заявка.py,
# routes/спортсмены.py /поиск, sync_regteam_rafting.py). Значение должно
# СОВПАДАТЬ со значением API_KEY в .env самого REGTEAM_RAFTING (см. его
# .env.example, заголовок X-API-Key).
REGTEAM_RAFTING_URL=http://127.0.0.1:5001
REGTEAM_RAFTING_API_KEY=change-me-to-a-random-api-key
