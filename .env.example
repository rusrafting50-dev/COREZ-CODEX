# Секретный ключ Flask (сессии, flash-сообщения)
SECRET_KEY=change-me-to-a-random-secret

# Адрес сайта RAFTING_CFO и API-ключ синхронизации соревнований.
# API-ключ должен СОВПАДАТЬ со значением API_KEY в .env самого сайта
# RAFTING_CFO (см. его .env.example, заголовок X-API-Key).
RAFTING_CFO_URL=http://127.0.0.1:5003
RAFTING_CFO_API_KEY=change-me-to-a-random-api-key

# Ключ для приёма заявок команд от сайта RAFTING_CFO (заголовок
# X-API-Key, см. routes/api.py) — обратное направление: сайт передаёт
# заявку сюда кнопкой «Отправить в COREZ». Значение должно СОВПАДАТЬ со
# значением COREZ_API_KEY в .env самого сайта RAFTING_CFO.
API_KEY=change-me-to-a-random-api-key
